  "activity": {
    "title": "Réseau du Lycée Pasteur",
    "level": "Seconde / BTS SIO",
    "instructions": "Dans cette activité, vous allez configurer et tester le réseau informatique du Lycée Pasteur. Le réseau comporte deux sous-réseaux : la salle informatique (192.168.1.0/24) et le réseau administratif (192.168.2.0/24), reliés par un routeur central.\n\n👉 Commencez par câbler et configurer PC Elève 3, puis testez les communications inter-réseaux.",
    "masteryscore": 60,
    "displayMode": "full",
    "objectives": [
      {
        "id": "obj1",
        "label": "Câbler PC Elève 3 au Switch Salle",
        "points": 10,
        "params": {
          "devA": "PC Elève 3",
          "devB": "Switch Salle"
        },
        "check": "cable_exists"
      },
      {
        "id": "obj2",
        "label": "Vérifier que le service DHCP du Serveur Intranet est actif",
        "points": 5,
        "params": {
          "dev": "Serveur Intranet",
          "service": "dhcp"
        },
        "check": "service_active"
      },
      {
        "id": "obj3",
        "label": "PC Elève 3 obtient une adresse IP via DHCP",
        "points": 15,
        "params": {
          "from": "PC Elève 3"
        },
        "check": "dhcp_success"
      },
      {
        "id": "obj4",
        "label": "PC Elève 3 a une IP dans la plage 192.168.1.150-200",
        "points": 5,
        "params": {
          "dev": "PC Elève 3",
          "ip": "192.168.1.150",
          "mask": "255.255.255.0"
        },
        "check": "ip_configured"
      },
      {
        "id": "obj5",
        "label": "Ping de PC Elève 1 vers le Serveur Intranet",
        "points": 10,
        "params": {
          "from": "PC Elève 1",
          "to": "192.168.1.100"
        },
        "check": "ping_success"
      },
      {
        "id": "obj6",
        "label": "Accès HTTP au Serveur Intranet depuis PC Elève 1",
        "points": 15,
        "params": {
          "from": "PC Elève 1",
          "url": "http://192.168.1.100"
        },
        "check": "http_success"
      },
      {
        "id": "obj7",
        "label": "Résolution DNS de intranet.lycee.local depuis PC Elève 1",
        "points": 10,
        "params": {
          "from": "PC Elève 1",
          "domain": "intranet.lycee.local"
        },
        "check": "dns_success"
      },
      {
        "id": "obj8",
        "label": "Ping de PC Elève 1 vers PC Admin (inter-réseau)",
        "points": 15,
        "params": {
          "from": "PC Elève 1",
          "to": "192.168.2.10"
        },
        "check": "ping_success"
      },
      {
        "id": "obj9",
        "label": "Accès au Site Web du Lycée depuis PC Elève 1 (www.lycee.local)",
        "points": 15,
        "params": {
          "from": "PC Elève 1",
          "url": "http://www.lycee.local"
        },
        "check": "http_success"
      }
    ]
  }
