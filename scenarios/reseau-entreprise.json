  "activity": {
    "title": "Réseau Entreprise — Serveur Web et DNS en panne",
    "level": "Terminale / BTS",
    "instructions": "Le réseau de l'entreprise comporte un serveur web (www.mon-entreprise.fr) auquel les employés doivent accéder. Depuis ce matin, les PCs ne peuvent plus joindre le site, et PC-Bob n'a plus accès à Internet.\n\n🔍 Votre mission :\n1. En mode Simulation, testez la connectivité : ping, nslookup, et navigateur web.\n2. Identifiez les pannes (deux problèmes à trouver !).\n3. Corrigez la configuration en mode Configuration.\n4. Prouvez que tout fonctionne : résolution du nom, accès au site depuis PC-Alice et PC-Bob, accès Internet de PC-Bob.\n\n🌐 URL à tester : www.mon-entreprise.fr\n💡 Commandes utiles : ipconfig, ping <IP>, nslookup <domaine>",
    "masteryscore": 60,
    "displayMode": "full",
    "objectives": [
      {
        "id": 1,
        "label": "PC-Alice joint le Serveur (ping)",
        "check": "ping_success",
        "params": {
          "from": "PC-Alice",
          "to": "{Serveur}"
        },
        "points": 5,
        "hint": "Terminal de PC-Alice : ping 192.168.1.100"
      },
      {
        "id": 2,
        "label": "Le service DNS du Serveur est actif",
        "check": "service_active",
        "params": {
          "dev": "Serveur",
          "service": "dns"
        },
        "points": 20,
        "hint": "nslookup échoue ? Vérifiez les services activés dans les propriétés du Serveur"
      },
      {
        "id": 3,
        "label": "Test : PC-Alice résout www.mon-entreprise.fr (nslookup)",
        "check": "dns_success",
        "params": {
          "from": "PC-Alice",
          "domain": "www.mon-entreprise.fr"
        },
        "points": 10,
        "hint": "Terminal de PC-Alice : nslookup www.mon-entreprise.fr"
      },
      {
        "id": 4,
        "label": "Test : PC-Alice ouvre le site www.mon-entreprise.fr",
        "check": "http_success",
        "params": {
          "from": "PC-Alice",
          "url": "www.mon-entreprise.fr"
        },
        "points": 15,
        "hint": "Onglet Navigateur : choisissez PC-Alice et entrez www.mon-entreprise.fr"
      },
      {
        "id": 5,
        "label": "Test : PC-Bob ouvre le site www.mon-entreprise.fr",
